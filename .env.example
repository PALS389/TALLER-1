# RadVol3D · environment variables
#
# Copy this file to `.env` at the repository root and fill in the real values.
# `.env` holds secrets and is never committed.

# PostgreSQL connection string. Supabase dashboard -> Connect -> Direct,
# choosing the Session pooler. Replace [YOUR-PASSWORD] with the real password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Base URL of the project. Project Settings -> Data API -> Project URL.
# No trailing path: it must end in .supabase.co
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Secret key. Project Settings -> API Keys -> secret.
# Grants full access: backend only, never in the web interface.
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Storage bucket that holds the binary files of every study.
STORAGE_BUCKET=radvol3d